{
  "name": "public-sites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @public-sites/landing dev",
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "preview": "pnpm --filter @public-sites/landing preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
