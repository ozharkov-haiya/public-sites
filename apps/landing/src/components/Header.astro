---
import Container from '@/components/Container.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const home = localizePath(locale);

const links = [
  { href: `${home}#features`, label: t.nav.features },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<header class="border-b border-ink/10">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a href={home} class="font-display text-lg font-semibold tracking-tight">
      {t.meta.siteName}
    </a>
    <nav aria-label={t.a11y.mainNav} class="hidden sm:block">
      <ul class="flex items-center gap-6 text-sm">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-ink-muted transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSwitcher locale={locale} />
  </Container>
</header>
