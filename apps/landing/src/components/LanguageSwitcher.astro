---
import { getRoutePath, localeNames, locales, localizePath, type Locale } from '@/i18n';
import { getDictionary } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const routePath = getRoutePath(Astro.url.pathname);
---

<nav aria-label={t.a11y.languageSwitcher}>
  <ul class="flex items-center gap-1 text-sm">
    {locales.map((l) => (
      <li>
        <a
          href={localizePath(l, routePath)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
          class="rounded px-2 py-1 text-ink-muted uppercase transition-colors hover:text-ink aria-[current]:font-semibold aria-[current]:text-ink"
        >
          <span class="sr-only">{localeNames[l]}</span>
          <span aria-hidden="true">{l}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
