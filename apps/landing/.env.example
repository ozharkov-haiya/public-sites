# Environment variables this site reads at build time.
#
# SITE_URL: absolute production URL, used for canonical, hreflang, OG and sitemap links.
#   Set it in Vercel (Project → Settings → Environment Variables → Production).
#   It is read by astro.config.mjs from the real environment, NOT from a .env file,
#   so to try it locally pass it inline:  SITE_URL=https://example.com pnpm build
#   When unset: Vercel's production URL on Vercel, http://localhost:4321 locally.
SITE_URL=https://example.com
